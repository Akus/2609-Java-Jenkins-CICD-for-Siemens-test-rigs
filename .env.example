# Copy to .env and adjust. All values have defaults in docker-compose.yml.

# Jenkins
JENKINS_PORT=8080
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=admin

# Grafana / Prometheus
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
PROMETHEUS_PORT=9090

# Rig broker API
RIG_API_PORT=8000
POLL_INTERVAL_S=5
RESERVATION_DEFAULT_TTL_S=1800
QUARANTINE_AFTER_FAILURES=3
LOG_LEVEL=info

# Rig simulators
VIENNA_FAIL_RATE=0.02
MUNICH_FAIL_RATE=0.15
FLASH_SECONDS=8

# Extras profile
SQLITE_WEB_PORT=8081
ALERTMANAGER_PORT=9093
CADVISOR_PORT=8082
